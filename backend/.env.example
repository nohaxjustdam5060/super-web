# Configuración de Servidor
#PORT=5000
#NODE_ENV=development
#CLIENT_URL=http://localhost:5173

# Base de Datos PostgreSQL (Compatible con Supabase, Neon, RDS, Railway, VPS)
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/super_ecommerce_db

# Autenticación JWT
JWT_SECRET=super_secret_jwt_key_tech_ecommerce_2026_change_in_prod
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_tech_ecommerce_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# Mercado Pago (Checkout Bricks & Webhooks)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=test_webhook_secret_key

# Email (Resend API)
RESEND_API_KEY=re_123456789
EMAIL_FROM="SUPER Tech Store <onboarding@resend.dev>"

# Storage (Supabase Storage S3 Adapter via @aws-sdk/client-s3)
STORAGE_PROVIDER=supabase
STORAGE_ENDPOINT=https://kmybcivvuyusgtxdbwmh.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ca-central-1
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_BUCKET=products
SUPABASE_URL=https://kmybcivvuyusgtxdbwmh.supabase.co

# Facturación Electrónica (NubeFact API v1)
NUBEFACT_URL=https://api.nubefact.com/api/v1/your-account-id
NUBEFACT_TOKEN=your_nubefact_token_here
NUBEFACT_SERIE_BOLETA=BBB1
NUBEFACT_SERIE_FACTURA=FFF1

# Monitoreo (Sentry)
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/000000
